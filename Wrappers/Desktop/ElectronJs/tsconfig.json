{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "dist",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "CoreLogic": ["../../../CoreLogic"]
    },
    "rootDirs": [
      "src",
      "../../../CoreLogic"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
