{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    /* Project References */
    "declaration": true,
    "declarationMap": true,
    "composite": true
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
